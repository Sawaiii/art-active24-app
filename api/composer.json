{
    "name": "art-active24/mobile-api",
    "description": "REST API мобильного приложения Art-Active24",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
    },
    "config": { "sort-packages": true }
}
