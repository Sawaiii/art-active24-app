ages/upload/mk-aquagrim-art-2023-new-1.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-art-2023-new-5.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-art-2023-new-1.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-art-2023-new-4.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/aqua-grim-art-2023-new-2.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-ne-meropriyatiye-art-2023-new-3.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-2.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-1.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-21.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-20.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-15.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-14.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-13.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-12.jpg"},{"type":"image","url":"https://www.art-active24.ru/images/upload/akvagrim-na-meropriyatie-2024-11.jpg"}],"price":{"amount":7500,"from":true,"unit":"","onRequest":false},"specs":[{"name":"Время на образ","value":"5–10 минут"},{"name":"Средняя проходимость","value":"8–10 чел./час"},{"name":"Возраст участников","value":"от 3 лет"}],"descriptionHtml":"<p><strong>Аквагрим на детский праздник</strong></p> <p>Выездной аквагрим — яркий творческий интерактив для детей и взрослых, который позволяет за несколько минут создать необычный образ, подчеркнуть тематику праздника или просто добавить ярких красок в мероприятие. Профессиональный художник создает рисунки на лице с учетом пожеланий участников и концепции события.</p> <p>Аквагрим легко адаптируется под любую тематику: Хэллоуин, Новый год, день рождения, тематическую вечеринку, корпоратив, фестиваль, детский праздник, День города и другие мероприятия. Это могут быть как небольшие декоративные рисунки, так и полноценные тематические образы.</p> <p>Мы привозим все необходимое для работы: профессиональные краски для аквагрима, кисти, спонжи, безопасные декоративные элементы, блестки и оборудование для организации рабочего места.</p> <p>Аквагрим становится не только развлечением, но и частью общей атмосферы мероприятия — участники получают яркий образ, возможность проявить индивидуальность и отличные фотографии на память.</p>","complectsLabel":"Техника аквагрима","complects":[{"id":5922,"title":"Простая техника","image":"https://www.art-active24.ru/images/upload/berdenko-14.jpg","rent":{"amount":7500,"label":"Стоимость","from":false,"sale":false,"onRequest":false,"minQty":1,"qtyStepPct":0}},{"id":5923,"title":"Средняя по сложности","image":"https://www.art-active24.ru/images/upload/berdenko-25.jpg","rent":{"amount":9000,"label":"Стоимость","from":false,"sale":false,"onRequest":false,"minQty":1,"qtyStepPct":0}}],"masterclass":{"variantsLabel":"Техника аквагрима","priceBadge":"за 10 человек","venueTitle":"Мастер-класс на нашей площадке","venueText":"Аквагрим можно провести не выездом, а у нас: три площадки в Москве под детский день рождения или корпоратив от 10 человек. Столы, вода и уборка — на нас.","venues":[{"name":"Зал «Венеция» (до 30 чел.)","text":"Отдельное помещение с комфортной посадкой за столы для большой группы. Подходит для одновременной организации и мастер-классов, и кейтеринга.","images":["https://www.art-active24.ru/images/upload/mk-46.jpg","https://www.art-active24.ru/images/upload/mk-venecia-14.jpg","https://www.art-active24.ru/images/upload/mk-venecia-13.jpg","https://www.art-active24.ru/images/upload/mk-venecia-12.jpg"]},{"name":"Беседки (до 15 чел. в каждой)","text":"Остекленные и утепленные беседки на нашем внутреннем дворе. Внутри помещается длинный стол, подходящий для групповых мастер-классов. Рядом — зона гриль-очага для перекуса в перерыве от творчества.","images":["https://www.art-active24.ru/images/upload/mk-48.jpg","https://www.art-active24.ru/images/upload/besedka-new-art-2026-1.jpg","https://www.art-active24.ru/images/upload/besedka-new-art-2026-2.jpg"]},{"name":"Отдельные комнаты (до 20 чел. в каждой)","text":"Камерные пространства, где нет ничего лишнего — только рабочие столы, удобные стулья и нужное оборудование. Ваше личное пространство с полной свободой творчества!","images":["https://www.art-active24.ru/images/upload/peregovor-new-art-2026-2.jpg","https://www.art-active24.ru/images/upload/peregovor-new-art-2026-1.jpg"]}],"stepsTitle":"Как проходит","steps":[{"title":"Выбор образа"},{"title":"Подбор цветов"},{"title":"Нанесение аквагрима"},{"title":"Добавление деталей"},{"title":"Готовое преображение"}],"includedTitle":"Что включено","included":["Работа профессионального аквагримера","Профессиональные краски для лица","Кисти, спонжи и расходные материалы","Блёстки и декоративные элементы","Организация рабочего места","Помощь в выборе образа"],"relatedTitle":"Тематические оформления","related":[{"id":1641,"slug":"master-klass-aero-tatu","name":"Аэро-тату на мероприятие","image":"https://www.art-active24.ru/images/upload/aero-tatu-na-meropriyatie-prev-big.jpg","price":{"amount":9000,"from":true,"unit":"","onRequest":false},"badge":{"text":"Хит","color":"#705ABF"},"template":"configurator"},{"id":5307,"slug":"masterklass-mehendi","name":"Мехенди на мероприятие","image":"https://www.art-active24.ru/images/upload/masterklass-mehendi-art-2025-new-ava-big-1.jpg","price":{"amount":6000,"from":true,"unit":"","onRequest":false},"badge":{"text":"Хит","color":"#705ABF"},"template":"configurator"},{"id":5308,"slug":"master-klass-teatralnyy-grim","name":"Театральный грим на мероприят