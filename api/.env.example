# Боевые значения по умолчанию. Для разработки см. блок «DEV» внизу.
APP_ENV=production

# Префикс, под которым API смонтирован на сайте. Веб-корень — ТОЛЬКО папка public/.
API_BASE_PATH=/api

# Адреса обратных прокси (nginx перед PHP) через запятую — только от них берётся X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1

# БД приложения: та же MySQL, что у сайта (таблицы app_*), ОТДЕЛЬНЫЙ пользователь с правами
# на app_* (+ SELECT на таблицы каталога CMS после подключения MysqlCatalogRepository).
DB_DSN=mysql:host=localhost;dbname=SITE_DB;charset=utf8mb4
DB_USER=
DB_PASSWORD=

# Источник каталога: snapshot (пока нет доступа к БД CMS) | mysql (после получения схемы)
CATALOG_SOURCE=snapshot
SNAPSHOT_DIR=

# Секрет хеширования SMS-кодов: случайная строка ≥ 32 символов (openssl rand -hex 32)
AUTH_PEPPER=

# SMS-шлюз (в production обязателен)
SMS_PROVIDER=smsru
SMSRU_API_ID=
SMSRU_FROM=

# Демо-вход для ревью App Store / Google Play: номер +79XXXXXXXXX и постоянный 6-значный код.
# Только на время ревью; номер не может входить в MANAGER_PHONES.
AUTH_REVIEW_PHONE=
AUTH_REVIEW_CODE=

# Телефоны менеджеров (+79XXXXXXXXX через запятую). Убрали номер — права пропадают сразу.
MANAGER_PHONES=

# Куда слать письма о заявках (через запятую) — в production обязательно
ORDER_NOTIFY_EMAILS=
ORDER_NOTIFY_FROM=app@art-active24.ru

# Лог приложения (по умолчанию var/log/app.log; off — выключить)
LOG_FILE=

# ── DEV ────────────────────────────────────────────────────────────────
# APP_ENV=development
# API_BASE_PATH=
# DB_DSN=sqlite:var/app.sqlite
# SMS_PROVIDER=log                       # коды пишутся в var/log/sms.log
# SNAPSHOT_DIR=tests/fixtures/snapshot   # маленький набор товаров для быстрого старта
